# ============================================================
# 环境变量模板
# 用法：cp .env.example .env（.env 已被 .gitignore 排除，不要提交）
#
# 注意：当前为最小可运行版本，后端仅提供 GET /health，
# 尚未读取以下业务变量。这些变量在接入登录 / 数据库 / 邮件后启用。
# ============================================================

# ---------- 运行环境 ----------
APP_ENV=dev
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000
# 服务端内部统一使用 UTC，展示时区由前端处理
APP_TIMEZONE=UTC

# ---------- 数据库（MySQL 8.0，尚未接入）----------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=tbscr
MYSQL_USER=tbscr
MYSQL_PASSWORD=change_me

# 注意：
# 1. 必须使用 utf8mb4，否则中文与特殊字符会出错。
# 2. 绝对不要追加 CLIENT_FOUND_ROWS 参数，否则满额时 affected_rows 仍返回 1，会导致超约。
DATABASE_URL=mysql+asyncmy://tbscr:change_me@127.0.0.1:3306/tbscr?charset=utf8mb4

# ---------- 认证（尚未接入）----------
# 生产环境必须替换为足够长的随机串：openssl rand -hex 32
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_DAYS=30

# ---------- 邮件 SMTP（登录验证码，尚未接入）----------
# 优先使用学校邮箱；若校内邮箱限制程序外发，改用企业邮或邮件推送服务。
# 发信域名必须配置 SPF / DKIM，否则验证码大概率进垃圾箱。
SMTP_HOST=smtp.example.edu.cn
SMTP_PORT=465
SMTP_USE_TLS=true
SMTP_USERNAME=noreply@example.edu.cn
SMTP_PASSWORD=change_me
SMTP_FROM_NAME=河北农业大学校医院
SMTP_FROM_EMAIL=noreply@example.edu.cn

# ---------- 验证码策略（尚未接入）----------
CODE_TTL_MINUTES=10
CODE_RESEND_INTERVAL_SECONDS=60
CODE_DAILY_LIMIT_PER_EMAIL=20
CODE_MAX_VERIFY_ATTEMPTS=5

# ---------- 业务参数（尚未接入）----------
CANCEL_CUTOFF_HOURS=24
# 可提前预约的天数（PRD Q1 待确认，暂取 7，确认后回填）
BOOKING_ADVANCE_DAYS=7

# ---------- 导出（尚未接入）----------
EXPORT_DIR=./storage/exports
EXPORT_LINK_TTL_MINUTES=30

# ---------- 跨域（仅 H5 调试需要；APK 不受同源限制）----------
ALLOWED_ORIGINS=http://localhost:5173

# ============================================================
# 前端变量放 frontend/.env，前缀必须是 VITE_
#   VITE_API_BASE_URL=http://127.0.0.1:8000
# 当前首页不请求接口，暂不需要。
# ============================================================
